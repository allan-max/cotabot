# Cotabot na VM (iniciar_vm.bat). Do .env só se leem as linhas COTABOT_*.
COTABOT_HOST=0.0.0.0
COTABOT_PORTA=8765
# 32+ caracteres aleatórios; o mesmo COTABOT_TOKEN do .env do gerenciador
COTABOT_TOKEN=
COTABOT_NAVEGADOR=chrome
# deviceId do navegador desta máquina (descubra com: .venv\Scripts\python.exe cotabot_local.py --navegadores)
COTABOT_NAVEGADOR_ID=
